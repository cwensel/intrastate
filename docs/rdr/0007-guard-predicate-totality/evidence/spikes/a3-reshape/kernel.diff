+func compareAtoms(a, b GuardAtom) int {
+	if c := strings.Compare(a.Key, b.Key); c != 0 {
+		return c
+	}
+	if c := strings.Compare(a.Op, b.Op); c != 0 {
+		return c
+	}
+	if c := strings.Compare(a.Literal, b.Literal); c != 0 {
+		return c
+	}
+	return strings.Compare(a.Block, b.Block)

+// evaluateAtom applies the kernel-owned presence/existence step before
+// delegating the value comparison to the seam. An atom naming a key the
+// view does not carry is decided by the kernel, never by the seam.
+func evaluateAtom(seam GuardEvaluator, atom GuardAtom, view TagSet) GuardResult {
+	value, _, ok := view.Lookup(atom.Key)
+	if !ok {
+		// Presence: an existence atom over an absent key is decided FALSE;
+		// any other atom over an absent key is undecidable.
+		if atom.Op == OpExists {
+			return GuardFalse
+		}
+		return GuardUnevaluable
+	}
+	if atom.Op == OpExists {
+		return GuardTrue
+	}
+	return seam.EvaluateAtom(atom, value, view)

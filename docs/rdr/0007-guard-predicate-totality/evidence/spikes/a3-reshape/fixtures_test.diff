+func guardObserved(rows []resolve.Row) []resolve.Tag {
+	var out []resolve.Tag
+	seen := map[string]bool{}
+	for _, r := range rows {
+		for _, a := range r.Guard {
+			if a.Key == "" || seen[a.Key] {

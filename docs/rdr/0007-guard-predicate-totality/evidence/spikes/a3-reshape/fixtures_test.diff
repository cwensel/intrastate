+// guardAtoms encodes a named predicate as a single-atom conjunction over
+// a synthetic key, so a test that used to say Guard: "never" now says
+// Guard: guardAtoms("never"). The atom key is the predicate name and the
+// literal is the truth the value stub will be asked to compare against.
+// Everything the seam sees is an ATOM; nothing injects a row verdict.
+func guardAtoms(names ...string) []resolve.GuardAtom {
+	out := make([]resolve.GuardAtom, 0, len(names))
+	for _, n := range names {
+		out = append(out, resolve.GuardAtom{
+			Key: "guard." + n, Op: "==", Literal: "hold", Block: n,
+		})
+	}
+	return out
+}
